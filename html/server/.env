# Copy to server/.env, then fill the server-only credentials. Do not use VITE_ names.
# R2 object: jk/models/example.json
R2_BUCKET=jk
R2_OBJECT_KEY=models/example.json
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional alternative to R2_ACCOUNT_ID, including jurisdiction-specific endpoints:
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Preserve the existing administrator password policy for permanent models.
MODEL_POOL_TOKEN=
# MODEL_POOL_ALLOWED_ORIGINS=https://viewer.example.com
# HOST=127.0.0.1
# PORT=4173
