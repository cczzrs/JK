    "input_protocol": {
      "initial": "Q1..Q10=0 and Q12=0 from their sole state definitions; Q6..Q10 are presence flags, so input slots are absent",
      "b5_zero": "emit F1.CLEAR=0; execute Q1..Q10 to clear values and presence; do not clear Q12 by this internal signal",
      "b5_rising_ready": "reserve one id, generate and stage one draft, then emit F1.CLEAR=0",
      "b5_rising_incomplete": "reject immediately, no reservation, no waiting call; Q12 remains 1 after normal commit",
      "b5_one_again": "Q12 EX still executes; no one_changed publication, so no creation",
      "after_success": "five values and five presence flags cleared; Q12 stays 1",
      "reset_scope": "only this requester instance input state; never already returned drafts, queued independent calls, or RAM frames",
      "data_updates": "each b0..b4 delivery replaces its own input slot and sets its presence q=1; this is explicitly a current configuration buffer, not ZIP or transaction-key matching",
      "programming_order": "one serialized programming stream per actual F1 instance; concurrent independent streams use separate F1 instances; a nested RAM construction executes each complete reset/program/enable sequence before the next"
    },
