      "reserve_key": "request_identity",
      "allocation": "high_water + 1 under exclusive reservation",
      "deletion": "never lowers high_water",
      "retry": "same reservation for same operation; separate requests receive separate ids",
      "aborted_reservation": "retained tombstone; numeric gaps allowed",
      "physical_slot_reuse": "does not reuse logical Q identity"
    },
