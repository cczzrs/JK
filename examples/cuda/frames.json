{
  "profile": "jkcuda.v6.1",
  "format_version": 1,
  "queues": [{"name": "input", "priority": 1}, {"name": "storage", "priority": 2}],
  "nodes": [
    {"id": "frame_data", "queue": "storage", "ex": "J0K(bit)",
     "sources": {"bit": {"kind": "PARAM", "param": "bit"}}, "output": "DATA"},
    {"id": "frame_marker", "queue": "storage", "ex": "J0K(marker)",
     "sources": {"marker": {"kind": "PARAM", "param": "marker"}}, "output": "FRAME_OUT"}
  ],
  "frame_module": {
    "input_queue": "input", "queue": "storage",
    "data_node": "frame_data", "data_param": "bit",
    "marker_node": "frame_marker", "marker_param": "marker",
    "block_capacity": 8, "max_width": 1024
  }
}
